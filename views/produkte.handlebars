<!-- Nachricht nach Hinzufügen -->
<div id="notification" style="display: none; position: fixed; top: 30px; left: 200px; background-color: #006742; color: white; padding: 10px; border-radius: 5px; z-index: 1000;">
  Produkt wurde zum Warenkorb hinzugefügt!
</div>

<!-- JavaScript zum Warenkorb -->
<script>
  function addToCart(element) {
    // Produktinformationen aus den data-Attributen abrufen
    const productId = element.getAttribute('data-id');
    const productName = element.getAttribute('data-name');
    const productPrice = parseFloat(element.getAttribute('data-price'));
    const productImg = element.getAttribute('data-img');
    const productQuantity = parseInt(element.getAttribute('data-quantity'), 10);

    // Produktobjekt erstellen
    const product = {
        id: productId,
        name: productName,
        price: productPrice,
        img: productImg,
        quantity: productQuantity
    };

    // Warenkorb aus dem Local Storage abrufen oder erstellen
    let cart = JSON.parse(localStorage.getItem('cart')) || [];

    // Überprüfen, ob das Produkt bereits im Warenkorb ist
    const existingProductIndex = cart.findIndex(item => item.id === productId);
    if (existingProductIndex > -1) {
        // Wenn das Produkt bereits im Warenkorb ist, die Menge erhöhen
        cart[existingProductIndex].quantity += productQuantity;
    } else {
        // Wenn das Produkt nicht im Warenkorb ist, es hinzufügen
        cart.push(product);
    }

    // Den aktualisierten Warenkorb im Local Storage speichern
    localStorage.setItem('cart', JSON.stringify(cart));

  // Bestätigungsmeldung in einem div anzeigen
  const notification = document.getElementById('notification');
    notification.textContent = `${productName} wurde zum Warenkorb hinzugefügt.`;
    notification.style.display = 'block';

    // Nach 3 Sekunden die Nachricht ausblenden
    setTimeout(() => {
        notification.style.display = 'none';
    }, 3000);
}
</script>

