<div class="box">
    <div class="intro">
      <h2>Dein Warenkorb</h2>
    </div>
  </div>
  <div id="cart">
      <!-- Hier wird der Inhalt des Warenkorbs angezeigt -->
  

    </div>
  
    <div class="box" id="box">
        <h2>Bevor du deine Bestellung abschliesst, brauchen wir noch ein paar Informationen.</h2>
        <form action="mailto:julia29ruchti@gmail.com" method="post">
            <p class="formp">Vorname</p>
            <input type="text" placeholder="Max">
        <p class="formp">Nachname</p>
            <input type="text" placeholder="Mustermann">
        <p class="formp">E-Mail</p>
            <input type="email" placeholder="maxmustermann@muster.ch">
        <p class="formp">Text auf Geschenkbox</p>
            <textarea class="textgeschenk" type="text" placeholder="Geschenkset Frühlingshonig und Sommerhonig je 250gGeschenkset Frühlingshonig und Sommerhonig je 250g -- Text: Alles gute zum Geburtstag"></textarea>


            <div id="total-price" class="h2"></div>
            <p class="endpreis">Du kannst deine Bestellung schon am nächsten Tag an unserer Verkaufstätte in <a class="link" href="https://maps.app.goo.gl/nJ2Sodz5AuPz3Aeb6">Hauptstrasse 9, 3317 Mülchi,</a> abholen. Die Bezahlung erfolgt mit Bargeld oder über Twint.</p>
    
                    <!-- Verstecktes Feld zum Speichern des Warenkorbs -->
                    <input type="hidden" id="cartData" name="cartData">
                    <div class="box">
            <button type="submit" class="bestellung">Bestellung aufgeben</button></div>
        </form>
    </div>

    
  
  <script>
      // Warenkorb aus dem Local Storage abrufen
      const cart = JSON.parse(localStorage.getItem('cart')) || [];
  
      // Warenkorb-Div abrufen
      const cartDiv = document.getElementById('cart');
  
      // Überprüfen, ob der Warenkorb leer ist
      if (cart.length === 0) {
          cartDiv.innerHTML = '<h1>Dein Warenkorb ist noch leer.</h1>';
      } else {
          // Produkte im Warenkorb anzeigen
          cart.forEach(product => {
              cartDiv.innerHTML += `
                  <div class="cart-item Produkte">
                      <img src="${product.img}" alt="${product.name}">
                      <div class="cart-item-container">
                      <div class="cart-item-details">
                          <h3 class="Produktname">${product.name}</h3>
                          <p>Preis: CHF ${product.price.toFixed(2)}</p>
                          <p>Menge: ${product.quantity}</p>
                      </div>
                      <div class="cart-item-remove" onclick="removeFromCart('${product.id}')">Entfernen</div>
                  </div>
              </div>
              `;
          });
  
          // Gesamtpreis berechnen und anzeigen
          calculateTotalPrice();
      }
  
      // Funktion zum Berechnen des Gesamtpreises
      function calculateTotalPrice() {
          let totalPrice = 0;
          cart.forEach(product => {
              totalPrice += product.price * product.quantity; // Preis x Menge
          });
  
          // Gesamtpreis anzeigen
          document.getElementById('total-price').textContent = `Gesamtpreis: CHF ${totalPrice.toFixed(2)}`;
      }
  
      // Funktion zum Entfernen eines Produkts aus dem Warenkorb
      function removeFromCart(productId) {
          const product = cart.find(item => item.id === productId);
          
          if (product) {
              if (product.quantity > 1) {
                  // Menge um 1 verringern
                  product.quantity -= 1; 
              } else {
                  // Produkt entfernen, wenn die Menge 1 ist
                  const updatedCart = cart.filter(item => item.id !== productId);
                  localStorage.setItem('cart', JSON.stringify(updatedCart));
                  location.reload();
                  return;
              }
          }
  
          // Warenkorb speichern und Seite neu laden
          localStorage.setItem('cart', JSON.stringify(cart));
          location.reload();
      }


      
  </script>
  
         
</div>



   </div>
</div>